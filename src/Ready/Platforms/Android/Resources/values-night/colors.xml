       不会和 values/ 里 MauiSplashScreen 生成的那一份冲突。 -->
  <color name="colorPrimary">#8FA184</color>
  <color name="colorPrimaryDark">#1A1210</color>
  <color name="colorAccent">#D86E4E</color>
