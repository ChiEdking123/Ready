<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- enableOnBackInvokedCallback：Android 13 起返回手势走 OnBackInvokedDispatcher。
       targetSdk 36 上预测性返回默认开启，这里显式写出来，让 33–35 也走同一条
       OnBackPressedDispatcher 路径，不必维护两套分支。 -->
  <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:label="Ready!" android:supportsRtl="true" android:enableOnBackInvokedCallback="true"></application>
  <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="36" />
</manifest>
